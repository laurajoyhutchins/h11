        "h11/_headers.py",
        "h11/_readers.py",
        "h11/_receivebuffer.py",
        "h11/_state.py",
        "h11/_util.py"
      ],
      "requires": [
        "Input buffer contains bytes of a valid HTTP/1.1 chunked body, optionally fragmented across calls",
        "Caller drains reader until an incomplete read or EndOfMessage"
      ],
      "guarantees": [
        "Concatenated Data payloads exactly equal decoded body bytes, without chunk framing",
        "Complete valid input terminates with EndOfMessage and preserves parsed trailers",
        "Fragmentation boundaries do not change the payload or end-of-message observation",
        "Invalid chunk size and footer are rejected",
        "Premature EOF is rejected"
      ],
      "oracle": "reader_oracles.py",
      "mutants": [
        "chunk-length-plus-one",
        "discard-only-lf",
        "drop-trailers"
      ]
    },
    {
      "id": "http1.chunked.writer",
      "entrypoint": "h11._writers.ChunkedWriter",
      "introduced_at": "chunked-writer",
      "implementation": "h11/_writers.py",
      "blob_sha": "939cdb912a9debaea07fbf3a9ac04549c44d077c",
      "import_closure": [
        "h11/_abnf.py",
        "h11/_events.py",
        "h11/_headers.py",
        "h11/_state.py",
        "h11/_util.py",
        "h11/_writers.py"
      ],
      "requires": [
        "Zero or more Data events followed by EndOfMessage",
        "Data payloads and trailers satisfy h11 event constructors"
      ],
      "guarantees": [
        "Nonempty Data is emitted as lowercase hexadecimal size, CRLF, exact payload and CRLF",
        "Empty Data emits no chunk",
        "EndOfMessage emits terminal zero chunk and serialized trailers",
        "Different nonempty Data events remain separately framed chunks"
      ],
      "oracle": "writer_oracles.py",
      "mutants": [
        "chunk-length-plus-one",
        "omit-data-footer-cr",
        "wrong-terminal-chunk"
      ]
    },
