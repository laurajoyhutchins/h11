  "scope": "HTTP/1.1 chunked transfer-body codecs in h11; not a complete HTTP protocol specification",
  "contracts": [
    {
      "id": "http1.chunked.reader",
      "entrypoint": "h11._readers.ChunkedReader",
      "introduced_at": "chunked-reader",
      "implementation": "h11/_readers.py",
      "blob_sha": "576804cc282032526e0a932c9853d586a094bad0",
